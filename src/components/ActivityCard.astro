---
import Icon from './Icon.astro';
import SiteImage from './SiteImage.astro';
import type { ActivityCard as Activity } from '../lib/activities';

const { item } = Astro.props as { item: Activity };
const labels: Record<string, string> = { github: 'GitHub', steam: 'Steam', vrchat: 'VRChat', bilibili: 'Bilibili', project: 'Project' };
const icons: Record<string, string> = { github: 'github', steam: 'gamepad-2', vrchat: 'badge', bilibili: 'tv', project: 'code' };
---
<a class={`activity-card activity-${item.type}`} href={item.href} target="_blank" rel="noreferrer">
  {item.image && <div class="activity-art"><SiteImage src={item.image} alt="" widths={[320, 640]} sizes="320px" /></div>}
  <div class="activity-copy">
    <div class="activity-kicker"><Icon name={item.icon || icons[item.type] || 'sparkles'} size={14} /> {item.label || labels[item.type] || item.type}</div>
    <h3>{item.title}</h3><p>{item.subtitle}</p><small>{item.metric}</small>
  </div>
  <Icon name="arrow-up-right" size={17} />
</a>
