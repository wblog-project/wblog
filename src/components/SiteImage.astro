---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src, alt, class: className, widths = [360, 640, 960, 1280], sizes = '100vw',
  loading = 'lazy', fetchpriority = 'auto',
} = Astro.props;
const remote = typeof src === 'string';
---
{remote ? (
  <img src={src} alt={alt} class={className} loading={loading} decoding="async" fetchpriority={fetchpriority} referrerpolicy="no-referrer" />
) : (
  <Picture
    src={src}
    alt={alt}
    class={className}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths}
    sizes={sizes}
    layout="constrained"
    fit="cover"
    position="center"
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
)}
