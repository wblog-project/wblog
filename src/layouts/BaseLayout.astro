---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import SiteImage from '../components/SiteImage.astro';
import { resolveSiteImage } from '../lib/images';
import { t } from '../lib/i18n';
import { absoluteUrl, siteConfig } from '../lib/site-config';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = siteConfig.site.title, description = siteConfig.site.description, image,
  type = 'website', published, updated, tags = [], noindex = false,
} = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const background = await resolveSiteImage(siteConfig.appearance.background);
const configuredOg = await resolveSiteImage(siteConfig.site.ogImage);
const socialSource = image || configuredOg;
const socialImage = socialSource ? await getImage({ src: socialSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const faviconSource = await resolveSiteImage(siteConfig.site.favicon);
const favicon = faviconSource ? await getImage({ src: faviconSource, width: 64, height: 64, fit: 'cover', format: 'png' }) : undefined;
const structuredData = type === 'article' ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  url: canonical, image: socialImage ? absoluteUrl(socialImage.src) : undefined,
  datePublished: published?.toISOString(), dateModified: (updated || published)?.toISOString(),
  author: { '@type': 'Person', name: siteConfig.profile.name, url: absoluteUrl('/about') }, keywords: tags,
} : {
  '@context': 'https://schema.org', '@type': 'WebSite', name: siteConfig.site.title,
  description: siteConfig.site.description, url: absoluteUrl('/'),
  author: { '@type': 'Person', name: siteConfig.profile.name, url: absoluteUrl('/about') },
};
---
<!doctype html>
<html lang={siteConfig.site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.title} RSS`} href={absoluteUrl('/rss.xml')} />
    {favicon && <link rel="icon" href={favicon.src} type="image/png" />}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content={type} /><meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.site.title} />
    {socialImage && <meta property="og:image" content={absoluteUrl(socialImage.src)} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={absoluteUrl(socialImage.src)} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body style={`--accent:${siteConfig.appearance.accent};--accent-soft:${siteConfig.appearance.accentSoft}`}>
    {background && <div class="site-background" aria-hidden="true"><SiteImage src={background} alt="" widths={[960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" /></div>}
    <a class="skip-link" href="#main-content">{t('skip')}</a>
    <div class="site-noise" aria-hidden="true"></div>
    <Header />
    <main id="main-content"><slot /></main>
    <footer class="site-footer shell">© {new Date().getFullYear()} {siteConfig.profile.name}. <span>│</span> {siteConfig.footer}</footer>
  </body>
</html>
