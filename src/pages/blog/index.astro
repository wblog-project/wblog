---
import { getCollection } from 'astro:content';
import SiteImage from '../../components/SiteImage.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, entrySlug } from '../../lib/content';
import { formatDate, t } from '../../lib/i18n';
import { siteConfig, withBase } from '../../lib/site-config';
const posts = byNewest((await getCollection('posts')).filter((item) => !item.data.draft));
---
<BaseLayout title={`${t('blog')} · ${siteConfig.site.title}`} description={t('blogIntro')}>
  <PageHero eyebrow={t('blog')} title={t('blogTitle')} intro={t('blogIntro')} />
  <section class="post-grid shell">
    {posts.length ? posts.map((post) => <article class="post-card">
      <a class="post-card-cover" href={withBase(`/blog/${entrySlug(post.id)}`)}>{post.data.cover && <SiteImage src={post.data.cover} alt={post.data.coverAlt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, 50vw" />}</a>
      <div><p class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p><h2><a href={withBase(`/blog/${entrySlug(post.id)}`)}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="tag-links">{post.data.tags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div></div>
    </article>) : <p class="empty-state">{t('noContent')}</p>}
  </section>
</BaseLayout>
