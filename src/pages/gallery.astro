---
import { getCollection } from 'astro:content';
import SiteImage from '../components/SiteImage.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest, entrySlug } from '../lib/content';
import { formatDate, t } from '../lib/i18n';
import { siteConfig, withBase } from '../lib/site-config';
const entries = byNewest(await getCollection('gallery'));
---
<BaseLayout title={`${t('gallery')} · ${siteConfig.site.title}`} description={t('galleryIntro')}>
  <PageHero eyebrow={t('gallery')} title={t('galleryTitle')} intro={t('galleryIntro')} />
  <section class="gallery-grid shell">{entries.length ? entries.map((entry) => <article class="gallery-item"><a href={withBase(`/gallery/${entrySlug(entry.id)}`)}><SiteImage src={entry.data.images[0].src} alt={entry.data.images[0].alt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, 50vw" /><span class="gallery-overlay"><small>{formatDate(entry.data.date)}</small><strong>{entry.data.title}</strong><span>{entry.data.description}</span></span></a></article>) : <p class="empty-state">{t('noContent')}</p>}</section>
</BaseLayout>
