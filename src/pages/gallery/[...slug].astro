---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import SiteImage from '../../components/SiteImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adjacentEntries, byNewest, entrySlug } from '../../lib/content';
import { formatDate, t } from '../../lib/i18n';
import { withBase } from '../../lib/site-config';
export async function getStaticPaths() {
  const entries = byNewest(await getCollection('gallery'));
  return entries.map((entry, index) => ({ params: { slug: entrySlug(entry.id) }, props: { entry, ...adjacentEntries(entries, index) } }));
}
const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const lightboxImages = await Promise.all(entry.data.images.map((image) => getImage({ src: image.src, width: 1920, format: 'webp' })));
---
<BaseLayout title={`${entry.data.title} · ${t('gallery')}`} description={entry.data.description} image={entry.data.images[0].src} type="article" published={entry.data.date}>
  <article class="article shell"><a class="back-link" href={withBase('/gallery')}>← {t('backGallery')}</a><p class="post-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> · {entry.data.images.length} {t('photos')}</p><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p>
    <div class="gallery-detail">{entry.data.images.map((image, index) => <a href={lightboxImages[index].src} data-lightbox-trigger={index}><SiteImage src={image.src} alt={image.alt} widths={[640, 960, 1280]} sizes="min(100vw, 800px)" /></a>)}</div><div class="prose"><Content /></div>
    <nav class="article-navigation" aria-label="Adjacent galleries">{previous ? <a href={withBase(`/gallery/${entrySlug(previous.id)}`)}><small>{t('previous')}</small><strong>{previous.data.title}</strong></a> : <span></span>}{next && <a class="next" href={withBase(`/gallery/${entrySlug(next.id)}`)}><small>{t('next')}</small><strong>{next.data.title}</strong></a>}</nav>
  </article>
  <dialog class="lightbox" data-lightbox><button type="button" class="lightbox-close" aria-label={t('close')} data-lightbox-close><Icon name="close" /></button>{entry.data.images.map((image, index) => <figure data-lightbox-slide={index} hidden={index !== 0}><SiteImage src={image.src} alt={image.alt} widths={[960, 1440, 1920]} sizes="95vw" /><figcaption>{image.alt}</figcaption></figure>)}</dialog>
</BaseLayout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-lightbox-slide]')];
  document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => trigger.addEventListener('click', (event) => {
    event.preventDefault();
    const index = Number(trigger.getAttribute('data-lightbox-trigger'));
    slides.forEach((slide, slideIndex) => { slide.hidden = slideIndex !== index; });
    dialog?.showModal();
  }));
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>
