---
import { getCollection } from 'astro:content';
import ActivityCard from '../components/ActivityCard.astro';
import ActivityPanel from '../components/ActivityPanel.astro';
import Icon from '../components/Icon.astro';
import SiteImage from '../components/SiteImage.astro';
import VrchatWorldCard from '../components/VrchatWorldCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActivities } from '../lib/activities';
import { byNewest, entrySlug } from '../lib/content';
import { resolveSiteImage } from '../lib/images';
import { formatDate, t } from '../lib/i18n';
import { siteConfig, withBase } from '../lib/site-config';
import { readVrchatSnapshot } from '../lib/vrchat';

const [activities, allPosts, allLife, allGallery] = await Promise.all([
  getActivities(), getCollection('posts'), getCollection('life'), getCollection('gallery'),
]);
const posts = byNewest(allPosts.filter((item) => !item.data.draft)).slice(0, 3);
const life = byNewest(allLife).slice(0, 4);
const gallery = byNewest(allGallery).slice(0, 4);
const { profile, socials, home } = siteConfig;
const heroImage = await resolveSiteImage(profile.heroImage);
const musicCover = await resolveSiteImage(home.music.cover);
const featuredSocials = socials.slice(0, 4);
const bilibiliActivities = activities.filter((item) => item.type === 'bilibili');
const githubActivities = activities.filter((item) => item.type === 'github' || item.type === 'project');
const otherActivities = activities.filter((item) => !['bilibili', 'github', 'project'].includes(item.type));
const bilibiliProfile = socials.find((social) => social.icon === 'tv')?.url;
const githubProfile = socials.find((social) => social.icon === 'github')?.url;
const vrchat = readVrchatSnapshot();
const vrchatProfileImage = vrchat?.profile.image ? await resolveSiteImage(vrchat.profile.image) : undefined;
const vrchatPreview = vrchat?.recentWorlds.slice(0, 3) || [];
const vrchatWorldImages = await Promise.all(vrchatPreview.map((world) => world.image ? resolveSiteImage(world.image) : undefined));
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><Icon name="sparkles" size={15} /> {profile.greeting}</p>
      <h1>{profile.name}</h1><p class="hero-bio">{profile.bio}</p>
      <p class="hero-status"><span></span>{profile.status}</p>
      <div class="social-row">
        {socials.map((social) => <a href={social.url} target="_blank" rel="noreferrer" aria-label={social.name} title={social.name}><Icon name={social.icon} /></a>)}
      </div>
      <div class="hero-metrics" aria-label="Homepage overview">
        <span><b>{socials.length}</b>{t('platforms')}</span><span><b>{posts.length + life.length + gallery.length}</b>{t('smallMoments')}</span>
      </div>
    </div>
    <div class="hero-art">
      {heroImage ? <SiteImage src={heroImage} alt={`${profile.name} hero artwork`} widths={[640, 960, 1280]} sizes="(max-width: 820px) 100vw, 50vw" loading="eager" fetchpriority="high" /> : <span class="hero-monogram">{profile.name.slice(0, 1)}</span>}
      <div class="hero-glow" aria-hidden="true"></div>
    </div>
  </section>

  <section class="platform-strip shell" aria-label={t('platforms')}>
    {featuredSocials.map((social) => <a href={social.url} target="_blank" rel="noreferrer"><Icon name={social.icon} /><span><strong>{social.name}</strong><small>{t('visit')}</small></span><Icon name="arrow-up-right" size={16} /></a>)}
  </section>

  {home.modules.vrchat && vrchat && <section class="vrchat-home shell">
    <div class="vrchat-home-profile">
      <div class="vrchat-home-avatar">{vrchatProfileImage ? <SiteImage src={vrchatProfileImage} alt="" widths={[180, 360]} sizes="116px" /> : <span>{vrchat.profile.displayName.slice(0, 1)}</span>}</div>
      <div><p class="eyebrow"><Icon name="badge" size={14} /> VRChat</p><h2>{vrchat.profile.displayName}</h2><p>{vrchat.profile.statusDescription || vrchat.profile.bio}</p><span><Icon name="users" size={14} /> {vrchat.profile.friendCount} {t('vrchatFriends')}</span></div>
      <a class="primary-action" href={withBase('/vrchat')}>{t('vrchatExplore')} <Icon name="arrow-up-right" size={15} /></a>
    </div>
    {vrchatPreview.length > 0 && <div class="vrchat-home-worlds">{vrchatPreview.map((world, index) => <VrchatWorldCard world={world} image={vrchatWorldImages[index]} compact index={index} />)}</div>}
  </section>}

  {home.modules.activities && <section class="section shell">
    <div class="section-heading"><div><p class="eyebrow"><Icon name="sparkles" size={14} /> {t('activitiesEyebrow')}</p><h2>{t('activitiesTitle')}</h2><p>{t('activitiesDescription')}</p></div></div>
    <div class="activity-panels">
      <ActivityPanel class="bilibili-panel" icon="tv" label="Bilibili" title={t('latestVideos')} href={bilibiliProfile} linkLabel={t('viewChannel')}>
        {bilibiliActivities.length ? <div class="bilibili-grid">{bilibiliActivities.map((item) => <ActivityCard item={item} />)}</div> : <p class="empty-state">{t('noContent')}</p>}
      </ActivityPanel>
      <ActivityPanel class="github-panel" icon="github" label="GitHub" title={t('recentProjects')} href={githubProfile} linkLabel={t('viewProfile')}>
        {githubActivities.length ? <div class="github-project-list">{githubActivities.map((item) => <a class="github-project" href={item.href} target="_blank" rel="noreferrer"><span class="github-project-icon"><Icon name="github" size={16} /></span><span class="github-project-copy"><strong>{item.title}</strong><span>{item.subtitle}</span><small>{item.metric}</small></span><Icon name="arrow-up-right" size={15} /></a>)}</div> : <p class="empty-state">{t('noContent')}</p>}
      </ActivityPanel>
      {otherActivities.length > 0 && <ActivityPanel class="other-activities-panel" icon="sparkles" label={t('moreActivities')} title={t('moreActivitiesTitle')}>
        <div class="other-activities-grid">{otherActivities.map((item) => <ActivityCard item={item} />)}</div>
      </ActivityPanel>}
    </div>
  </section>}

  <section class="content-grid shell">
    {home.modules.dailyLife && <article class="panel daily-panel">
      <div class="panel-heading"><div><p class="eyebrow"><Icon name="camera" size={14} /> {t('dailyLife')}</p><h2>{t('smallMoments')}</h2></div><a href={withBase('/life')}>{t('viewAll')} {t('dailyLife')} <Icon name="arrow-up-right" size={15} /></a></div>
      {life.length > 0 && <div class="mini-gallery">{life.map((entry) => <a href={withBase(`/life/${entrySlug(entry.id)}`)} aria-label={entry.data.title}><SiteImage src={entry.data.images[0].src} alt={entry.data.images[0].alt} widths={[180, 360]} sizes="140px" /></a>)}</div>}
      {life.length ? <ul class="life-list">{life.map((entry) => <li><span>✦</span><a href={withBase(`/life/${entrySlug(entry.id)}`)}>{entry.data.title}</a><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, { month: 'short', day: 'numeric' })}</time></li>)}</ul> : <p class="empty-state">{t('noContent')}</p>}
    </article>}

    {home.modules.blog && <article class="panel blog-panel">
      <div class="panel-heading"><div><p class="eyebrow"><Icon name="code" size={14} /> {t('blog')}</p><h2>{t('thoughts')}</h2></div><a href={withBase('/blog')}>{t('viewAll')} {t('blog')} <Icon name="arrow-up-right" size={15} /></a></div>
      {posts.length ? <ul class="post-list">{posts.map((post) => <li>{post.data.cover && <SiteImage src={post.data.cover} alt="" widths={[120]} sizes="60px" />}<div><a href={withBase(`/blog/${entrySlug(post.id)}`)}>{post.data.title}</a><p>{post.data.tags.join(' · ') || 'Notes'}</p></div><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, { month: 'short', day: 'numeric' })}</time></li>)}</ul> : <p class="empty-state">{t('noContent')}</p>}
    </article>}

    {home.modules.gallery && <article class="panel gallery-panel">
      <div class="panel-heading"><div><p class="eyebrow"><Icon name="camera" size={14} /> {t('gallery')}</p><h2>{t('latestFrames')}</h2></div><a href={withBase('/gallery')}>{t('viewAll')} {t('gallery')} <Icon name="arrow-up-right" size={15} /></a></div>
      <div class="gallery-preview">{gallery.slice(0, 3).map((entry) => <a href={withBase(`/gallery/${entrySlug(entry.id)}`)}><SiteImage src={entry.data.images[0].src} alt={entry.data.images[0].alt} widths={[260, 520]} sizes="220px" /><span>{entry.data.title}</span></a>)}</div>
    </article>}

    {home.modules.music && <article class="panel music-panel">
      <div class="panel-heading"><div><p class="eyebrow"><Icon name="music" size={14} /> {t('listening')}</p><h2>{t('onRepeat')}</h2></div></div>
      <a class="music-card" href={home.music.link} target="_blank" rel="noreferrer">{musicCover ? <SiteImage src={musicCover} alt="" widths={[140]} sizes="70px" /> : <span class="album-placeholder">♫</span>}<span><strong>{home.music.title}</strong><small>{home.music.artist}</small></span><Icon name="arrow-up-right" /></a>
    </article>}

    {home.modules.about && <article class="panel about-panel">
      <div class="panel-heading"><div><p class="eyebrow"><Icon name="heart" size={14} /> {t('about')}</p><h2>{t('aboutTitle')}</h2></div><a href={withBase('/about')}>{t('about')} <Icon name="arrow-up-right" size={15} /></a></div>
      <div class="about-copy"><div class="tag-cloud">{home.aboutTags.map((tag) => <span>{tag}</span>)}</div><div class="about-orbit" aria-hidden="true"><span>✦</span><b>{profile.name.slice(0, 1)}</b><span>✧</span></div></div>
    </article>}
  </section>
</BaseLayout>
