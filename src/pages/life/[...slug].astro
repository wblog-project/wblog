---
import { getCollection, render } from 'astro:content';
import ArticleImages from '../../components/ArticleImages.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adjacentEntries, byNewest, entrySlug } from '../../lib/content';
import { formatDate, t } from '../../lib/i18n';
import { withBase } from '../../lib/site-config';
export async function getStaticPaths() {
  const entries = byNewest(await getCollection('life'));
  return entries.map((entry, index) => ({ params: { slug: entrySlug(entry.id) }, props: { entry, ...adjacentEntries(entries, index) } }));
}
const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.title} · ${t('dailyLife')}`} description={entry.data.summary} image={entry.data.images[0].src} type="article" published={entry.data.date}>
  <article class="article shell"><a class="back-link" href={withBase('/life')}>← {t('backLife')}</a><p class="post-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.summary}</p>
    <ArticleImages class="story-images" images={entry.data.images} /><div class="prose"><Content /></div>
    <ArticleNavigation previous={previous} next={next} basePath="/life" label="Adjacent moments" />
  </article>
</BaseLayout>
